
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is admin (using the phone number for this prototype)
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == '9060873927';
    }

    match /users/{userId} {
      // Users can read any profile (needed for team/invite logic)
      allow read: if request.auth != null;
      // Users can only write to their own profile, Admins can write to any
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /orders/{orderId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      
      match /sellOrders/{orderId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      
      match /transactions/{transactionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
      
      match /dailyRewards/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /chatRequests/{requestId} {
      allow create: if true;
      allow read, update: if true;
    }
    
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null || isAdmin();
    }
    
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Rules for Collection Group queries used in admin panel and team page
    match /{path=**}/orders/{orderId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/sellOrders/{orderId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/transactions/{transactionId} {
      allow read: if request.auth != null;
    }
  }
}
