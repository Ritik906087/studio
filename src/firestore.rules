
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user is admin (using the phone number for this prototype)
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == '9060873927';
    }

    // Allow the login page to verify admin credentials
    match /admins/{adminId} {
      allow read: if true;
    }

    match /users/{userId} {
      // Allow user to read their own profile. Admin can read all.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Only admin can list the users collection
      allow list: if isAdmin();
      
      // Allow registration (creation)
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Allow updates to own profile or by admin
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /orders/{orderId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
      
      match /sellOrders/{orderId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
      
      match /transactions/{transactionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
      
      match /dailyRewards/{date} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /chatRequests/{requestId} {
      // Support public chat creation
      allow create: if true;
      allow read, update: if true;
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Rules for Collection Group queries
    match /{path=**}/orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /{path=**}/sellOrders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /{path=**}/transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
