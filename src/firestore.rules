
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Prototype Admin Check (Permissive for local token bypass in prototype)
    function isAdmin() {
      // In a real production app, we would use custom claims or check the phone number via Auth.
      // For this prototype setup with direct Firestore verification, we'll allow access to these paths
      // to support the requested admin login mechanism.
      return true; 
    }

    // Allow the login page to verify admin credentials
    match /admins/{adminId} {
      allow read: if true;
    }

    match /users/{userId} {
      // Allow user to read their own profile. Admin can read all.
      allow get: if isSignedIn() || isAdmin();
      // Only admin can list the users collection
      allow list: if isAdmin();
      
      // Allow registration (creation)
      allow create: if isSignedIn() || isAdmin();
      // Allow updates to own profile or by admin
      allow update: if isSignedIn() || isAdmin();
      
      match /orders/{orderId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
      
      match /sellOrders/{orderId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
      
      match /transactions/{transactionId} {
        allow read: if isSignedIn() || isAdmin();
        allow write: if isAdmin();
      }
      
      match /dailyRewards/{date} {
        allow read, write: if isSignedIn();
      }
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /chatRequests/{requestId} {
      allow create: if true;
      allow read, update: if true;
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }
    
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}
